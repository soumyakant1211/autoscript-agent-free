# ===== Required =====
# Free Postgres from https://neon.com → project → Connect → copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Random 32+ character secret. Generate one: npx @better-auth/cli secret   (or any long random string)
BETTER_AUTH_SECRET=
# Your app's public URL, e.g. https://autoscript-agent-pro.onrender.com (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# AI provider: gemini (free, default) | groq | openrouter | ollama | anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Your own email(s) — become Admin on first sign-in (Google/Microsoft/GitHub/email link). Comma-separated.
ADMIN_EMAILS=you@example.com

# Your PRIVATE admin login (email + password form). Set only here / in Render — never shown on the site.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# ===== Sign-in providers (each is optional — a button appears only when configured) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email magic links. Without RESEND_API_KEY the link is printed to the server log (dev only).
RESEND_API_KEY=
EMAIL_FROM=AutoScript Agent <onboarding@resend.dev>

# ===== Demo accounts (one-click "Demo admin (read-only)" and "Demo member" buttons) =====
DEMO_LOGINS=1
# Shown PUBLICLY on the sign-in page for the demo accounts — never reuse a real password
DEMO_PASSWORD=Recruiter@2026

# ===== Optional tuning =====
LIMIT_ANON=2
LIMIT_GUEST=5
LIMIT_MEMBER=50
LIMIT_DEMO_ADMIN=5
AI_MODEL=
MAX_TOKENS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# MOCK_MODE=1 → canned AI responses, no API calls (for testing)
MOCK_MODE=
