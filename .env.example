# ---------- AI provider (all free options) ----------
# gemini (default, best free quality) | groq | openrouter | ollama (runs on your PC) | anthropic (paid)
AI_PROVIDER=gemini

# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Other free providers (only the one matching AI_PROVIDER is needed)
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (also set AI_MODEL to a model ending in ":free")
OLLAMA_URL=http://localhost:11434

# Optional overrides
AI_MODEL=                # leave empty for the provider's default
MAX_TOKENS=
PORT=8080

# Protect your free quota on a public URL
APP_PASSWORD=change-me
RATE_LIMIT_PER_HOUR=20

# MOCK_MODE=1 → canned responses, no AI calls at all
MOCK_MODE=
