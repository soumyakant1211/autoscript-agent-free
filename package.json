    "@vscode/tree-sitter-wasm": "^0.3.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1"
